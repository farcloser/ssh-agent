readonly COLOR_RED=1
readonly COLOR_GREEN=2
readonly COLOR_YELLOW=3

log::stamp(){
  local color="$1"
  local level="$2"
  local i
  shift
  shift

  [ -z "${TERM:-}" ] || [ ! -t 2 ] || >&2 tput setaf "$color" 2>/dev/null || true
  for i in "$@"; do
    >&2 printf "[%s] [%s] %s\n" "$(date 2>/dev/null || true)" "$level" "$i"
  done
  [ -z "${TERM:-}" ] || [ ! -t 2 ] || >&2 tput op 2>/dev/null || true
}

log::info(){
  log::stamp "$COLOR_GREEN" "INFO" "$@"
}

log::warning(){
  log::stamp "$COLOR_YELLOW" "WARNING" "$@"
}

log::error(){
  log::stamp "$COLOR_RED" "ERROR" "$@"
}

fs::ensuredir(){
  local pth="$1"
  mkdir -p "$pth" 2>/dev/null
  [ -d "$pth" ] || {
    log::error "Failed to create $pth. Check your permissions."
    return 1
  }
}

# The agent socket. NOT ~/.ssh/agent: since OpenSSH 10 (and the macOS 26
# system ssh-agent), ssh-agent's own default socket lives in a DIRECTORY at
# $HOME/.ssh/agent/s.*, so a socket FILE at that path collides with it — the
# system agent creates the directory on first use, `rm -f` cannot remove it,
# and the bind below fails. A sibling file name sidesteps that for good.
readonly socket=.ssh/agent.sock

fs::ensuredir "$(dirname "$HOME/$socket")"

# Traces of brew
ssh_agent_binary="${1:-$(brew --prefix 2>/dev/null || printf "/usr")/bin/ssh-agent}"
readonly ssh_agent_binary

# An agent already bound to OUR socket is the only "already running" that
# matters (pgrep ORs its patterns, so matching the binary alone would also
# trip on any other ssh-agent the user runs).
! pgrep -f -- "-a $HOME/$socket" >/dev/null || {
  log::error "Agent already running"
  exit 1
}

[ -e "$ssh_agent_binary" ] || {
  log::error "$ssh_agent_binary is missing"
  exit 1
}

# Delete any spurious remnant of a previous instance (a dead socket file).
rm -f "$HOME/$socket"

# Previous versions bound the socket at ~/.ssh/agent — the path the system
# agent now uses as a directory. A leftover socket FILE there is ours: drop
# it. A directory there is the system agent's: leave it alone.
[ ! -S "$HOME/.ssh/agent" ] || rm -f "$HOME/.ssh/agent"

# Sourced by the login shell, so it must not set shell options: a `set -o
# errexit -o nounset` here would leak into every interactive session.
cat <<-EOF > "$HOME/.posh_ssh"
# ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★
# ★ Kingpin             ★
# ★ (c) 2023, Farcloser ★
# ★ MIT License         ★
# ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★ ★

export SSH_AUTH_SOCK="\$HOME/$socket"
EOF

log::info "Initialization done. Starting the agent now."
# Start it in the foreground
exec "$ssh_agent_binary" -D -a "$HOME/$socket"
