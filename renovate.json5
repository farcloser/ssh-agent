{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Also bumps aqua_version in CI/devcontainer files, not only aqua.yaml.
    "github>aquaproj/aqua-renovate-config#2.13.0",
  ],
  // Supply-chain cooldown: wait before proposing a bump. Doubles as protection
  // against the race where a release tag exists but its assets aren't uploaded yet.
  minimumReleaseAge: "3 days",
  customManagers: [
    // go_install pins (github.com/<owner>/<repo>[/<pkg>]@vX.Y.Z): the aqua
    // preset cannot read a dotted owner, and its `_go/` hook needs the two-line
    // `version:` form that `aqua update` refuses to bump. Plain vX.Y.Z only —
    // pseudo-versions (untagged modules) are deliberately left alone.
    {
      customType: "regex",
      managerFilePatterns: ["/(^|/)aqua\\.ya?ml$/"],
      matchStrings: [
        " +- +name: +(?<depName>github\\.com/[^@'\" \\n]+)@(?<currentValue>v\\d+\\.\\d+\\.\\d+)[ \\n]",
      ],
      datasourceTemplate: "go",
    },
  ],
  packageRules: [
    // lychee tags releases "lychee-vX.Y.Z" (next to "lychee-lib-vX.Y.Z" and
    // "nightly"), and the aqua preset has no manager for that prefix in either
    // pin form: it reads "lychee-v0.24.2" as the version, cannot order it, and
    // never proposes a bump. Regex versioning that carries the prefix parses
    // the pinned value and the candidate tags alike, and excludes the lib and
    // nightly tags by construction.
    {
      matchDepNames: ["lycheeverse/lychee"],
      versioning: "regex:^lychee-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
  ],
  // `just do lint commits` enforces DCO on every PR range, bot commits included.
  commitBody: "Signed-off-by: renovate[bot] <29139614+renovate[bot]@users.noreply.github.com>",
  // The update-aqua-checksum workflow pushes a fix-up commit onto Renovate's
  // branches; without this, Renovate treats the branch as human-modified and
  // stops rebasing it.
  gitIgnoredAuthors: [
    "300983632+limen-ci-farcloser[bot]@users.noreply.github.com",
    "41898282+github-actions[bot]@users.noreply.github.com",
  ],
}
